{
  "expo": {
    "name": "Cegonha",
    "slug": "cegonha",
    "owner": "marinalupitta",
    "scheme": "cegonha",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Cegonha precisa usar a câmera para fotografar etiquetas de encomendas.",
          "photosPermission": "O Cegonha precisa acessar suas fotos para analisar etiquetas de encomendas."
        }
      ],
      "expo-notifications",
      "@react-native-google-signin/google-signin"
    ],
    "android": {
      "package": "com.maymay79p.cegonha",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F5F0"
      }
    },
    "ios": {
      "bundleIdentifier": "com.maymay79p.cegonha"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "674830ff-4cb9-46ba-ac15-4e6d959534b6"
      }
    }
  }
}
