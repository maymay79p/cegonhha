{
  "name": "Cegonha",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node scripts/start-expo.js dev",
    "dev": "node scripts/start-expo.js dev",
    "start:dev": "node scripts/start-expo.js dev",
    "go": "node scripts/start-expo.js go",
    "android": "node scripts/start-expo.js dev --android",
    "dev:android": "node scripts/start-expo.js dev --android",
    "go:android": "node scripts/start-expo.js go --android",
    "ios": "node scripts/start-expo.js dev --ios",
    "web": "expo start --web --clear --port 19002",
    "build:android": "node scripts/rebuild-android.js",
    "rebuild:android": "node scripts/rebuild-android.js",
    "build:preview:android": "npx eas-cli@latest build --profile preview -p android --clear-cache",
    "check:expo-go": "node scripts/check-expo-go.js",
    "check": "npm run typecheck && npm run check:expo-go && npx expo-doctor@latest",
    "doctor": "npx expo-doctor@latest",
    "typecheck": "tsc --noEmit",
    "firebase:auth": "npx firebase-tools@latest deploy --only auth --project cegonha-43403",
    "firebase:rules": "npx firebase-tools@latest deploy --only firestore:rules --project cegonha-43403",
    "firebase:functions": "npx firebase-tools@latest deploy --only functions --project cegonha-43403",
    "firebase:deploy": "npm run firebase:rules",
    "firebase:deploy:push": "npm run firebase:rules && npm run firebase:functions"
  },
  "dependencies": {
    "@expo-google-fonts/eb-garamond": "^0.4.3",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "expo": "~57.0.27",
    "expo-auth-session": "~57.0.12",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.20",
    "expo-font": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-notifications": "~57.0.23",
    "expo-ocr-kit": "^0.1.4",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@types/react": "^19.2.0",
    "babel-preset-expo": "^57.0.0",
    "typescript": "~6.0.3"
  }
}
