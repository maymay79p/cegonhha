{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1",
        "CEGONHA_NATIVE_RUNTIME": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1",
        "CEGONHA_NATIVE_RUNTIME": "1"
      }
    },
    "production": {
      "env": {
        "EAS_NO_FROZEN_LOCKFILE": "1",
        "CEGONHA_NATIVE_RUNTIME": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
