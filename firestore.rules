rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function porteiro() { return logado() && perfil().tipo == 'porteiro'; }
    function morador() { return logado() && perfil().tipo == 'morador'; }

    function mesmoCondominio(id) {
      return logado()
        && id is string
        && id.size() > 0
        && perfil().get('condominioId', '') == id;
    }

    function usuarioExiste(uid) {
      return uid is string
        && uid.size() > 0
        && exists(/databases/$(database)/documents/usuarios/$(uid));
    }

    function usuarioNoCondominio(uid, condominioId) {
      return usuarioExiste(uid)
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.get('condominioId', '') == condominioId;
    }

    function moradorExiste(uid) {
      return usuarioExiste(uid)
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.tipo == 'morador';
    }

    function moradorNoCondominio(uid, condominioId) {
      return moradorExiste(uid)
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.get('condominioId', '') == condominioId;
    }

    function solicitacaoAprovadaPara(novoCondominioId, solicitacaoId) {
      return solicitacaoId is string
        && solicitacaoId.size() > 0
        && exists(/databases/$(database)/documents/solicitacoesCondominio/$(solicitacaoId))
        && get(/databases/$(database)/documents/solicitacoesCondominio/$(solicitacaoId)).data.moradorId == request.auth.uid
        && get(/databases/$(database)/documents/solicitacoesCondominio/$(solicitacaoId)).data.condominioId == novoCondominioId
        && get(/databases/$(database)/documents/solicitacoesCondominio/$(solicitacaoId)).data.status == 'aprovada';
    }

    function banidoNoMural(condominioId, uid) {
      return exists(/databases/$(database)/documents/muralBanidos/$(condominioId + '_' + uid))
        && get(/databases/$(database)/documents/muralBanidos/$(condominioId + '_' + uid)).data.get('ativo', false) == true
        && get(/databases/$(database)/documents/muralBanidos/$(condominioId + '_' + uid)).data.get('condominioId', '') == condominioId;
    }

    function notificacaoVinculoValidaParaMorador() {
      return request.resource.data.tipo == 'vinculo'
        && request.resource.data.referenciaId is string
        && request.resource.data.referenciaId.size() > 0
        && existsAfter(/databases/$(database)/documents/solicitacoesCondominio/$(request.resource.data.referenciaId))
        && getAfter(/databases/$(database)/documents/solicitacoesCondominio/$(request.resource.data.referenciaId)).data.moradorId == request.resource.data.moradorId
        && getAfter(/databases/$(database)/documents/solicitacoesCondominio/$(request.resource.data.referenciaId)).data.condominioId == request.resource.data.condominioId
        && getAfter(/databases/$(database)/documents/solicitacoesCondominio/$(request.resource.data.referenciaId)).data.status in ['aprovada', 'rejeitada'];
    }

    function avisoSolicitacaoValidoParaPortaria() {
      return morador()
        && request.resource.data.tipo == 'solicitacao_vinculo'
        && request.resource.data.referenciaId is string
        && request.resource.data.referenciaId.size() > 0
        && existsAfter(/databases/$(database)/documents/solicitacoesCondominio/$(request.resource.data.referenciaId))
        && getAfter(/databases/$(database)/documents/solicitacoesCondominio/$(request.resource.data.referenciaId)).data.moradorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/solicitacoesCondominio/$(request.resource.data.referenciaId)).data.condominioId == request.resource.data.condominioId
        && getAfter(/databases/$(database)/documents/solicitacoesCondominio/$(request.resource.data.referenciaId)).data.status == 'pendente';
    }

    function avisoPrevisaoValidoParaPortaria() {
      return morador()
        && request.resource.data.tipo == 'previsao'
        && mesmoCondominio(request.resource.data.condominioId)
        && request.resource.data.referenciaId is string
        && request.resource.data.referenciaId.size() > 0
        && existsAfter(/databases/$(database)/documents/previsoes/$(request.resource.data.referenciaId))
        && getAfter(/databases/$(database)/documents/previsoes/$(request.resource.data.referenciaId)).data.moradorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/previsoes/$(request.resource.data.referenciaId)).data.condominioId == request.resource.data.condominioId;
    }

    function avisoDenunciaValidoParaPortaria() {
      return request.resource.data.tipo == 'denuncia'
        && mesmoCondominio(request.resource.data.condominioId)
        && request.resource.data.referenciaId is string
        && request.resource.data.referenciaId.size() > 0
        && existsAfter(/databases/$(database)/documents/muralDenuncias/$(request.resource.data.referenciaId))
        && getAfter(/databases/$(database)/documents/muralDenuncias/$(request.resource.data.referenciaId)).data.denuncianteId == request.auth.uid
        && getAfter(/databases/$(database)/documents/muralDenuncias/$(request.resource.data.referenciaId)).data.condominioId == request.resource.data.condominioId;
    }

    function avisoInteracaoEncomendaValidoParaPortaria() {
      return morador()
        && request.resource.data.tipo in ['retirada_solicitada', 'contestacao_encomenda']
        && mesmoCondominio(request.resource.data.condominioId)
        && request.resource.data.encomendaId is string
        && request.resource.data.encomendaId.size() > 0
        && request.resource.data.referenciaId in ['retirada', 'contestacao']
        && existsAfter(/databases/$(database)/documents/encomendas/$(request.resource.data.encomendaId)/interacoes/$(request.resource.data.referenciaId))
        && getAfter(/databases/$(database)/documents/encomendas/$(request.resource.data.encomendaId)/interacoes/$(request.resource.data.referenciaId)).data.tipo == request.resource.data.tipo
        && getAfter(/databases/$(database)/documents/encomendas/$(request.resource.data.encomendaId)/interacoes/$(request.resource.data.referenciaId)).data.moradorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/encomendas/$(request.resource.data.encomendaId)/interacoes/$(request.resource.data.referenciaId)).data.encomendaId == request.resource.data.encomendaId
        && getAfter(/databases/$(database)/documents/encomendas/$(request.resource.data.encomendaId)/interacoes/$(request.resource.data.referenciaId)).data.condominioId == request.resource.data.condominioId;
    }

    function avisoRespostaMuralValido() {
      return request.resource.data.tipo == 'resposta_mural'
        && mesmoCondominio(request.resource.data.condominioId)
        && request.resource.data.remetenteId == request.auth.uid
        && request.resource.data.destinatarioId is string
        && request.resource.data.destinatarioId.size() > 0
        && request.resource.data.destinatarioId != request.auth.uid
        && usuarioNoCondominio(request.resource.data.destinatarioId, request.resource.data.condominioId)
        && request.resource.data.referenciaId is string
        && request.resource.data.referenciaId.size() > 0
        && existsAfter(/databases/$(database)/documents/mural/$(request.resource.data.referenciaId))
        && getAfter(/databases/$(database)/documents/mural/$(request.resource.data.referenciaId)).data.autorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/mural/$(request.resource.data.referenciaId)).data.condominioId == request.resource.data.condominioId
        && getAfter(/databases/$(database)/documents/mural/$(request.resource.data.referenciaId)).data.respostaParaAutorId == request.resource.data.destinatarioId
        && request.resource.data.destinatarioTipo == get(/databases/$(database)/documents/usuarios/$(request.resource.data.destinatarioId)).data.tipo
        && (
          (request.resource.data.destinatarioTipo == 'morador'
            && request.resource.data.moradorId == request.resource.data.destinatarioId
            && request.resource.data.lida == false) ||
          (request.resource.data.destinatarioTipo == 'porteiro'
            && request.resource.data.lidaPor is list
            && request.resource.data.lidaPor.size() == 0)
        );
    }

    match /condominios/{condominioId} {
      allow get: if true;
      allow list: if false;
      allow create: if logado()
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.codigo == condominioId
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 3;
      allow update: if logado() && (
        resource.data.criadoPor == request.auth.uid ||
        (porteiro() && mesmoCondominio(condominioId))
      );
      allow delete: if false;
    }

    match /identificadoresUsuarios/{id} {
      allow get, list: if false;
      allow create: if logado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo in ['cpf', 'telefone']
        && request.resource.data.chave == id;
      allow update: if logado()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.chave == resource.data.chave
        && request.resource.data.chave == id;
      allow delete: if logado() && resource.data.uid == request.auth.uid;
    }

    match /usuarios/{uid} {
      allow create: if logado()
        && request.auth.uid == uid
        && request.resource.data.tipo in ['morador', 'porteiro']
        && request.resource.data.condominioId is string
        && (
          (request.resource.data.tipo == 'morador' && request.resource.data.condominioId == '') ||
          (request.resource.data.tipo == 'porteiro'
            && request.resource.data.condominioId.size() == 7
            && existsAfter(/databases/$(database)/documents/condominios/$(request.resource.data.condominioId)))
        );
      allow read: if logado() && (
        request.auth.uid == uid || mesmoCondominio(resource.data.get('condominioId', ''))
      );
      allow update: if logado()
        && request.auth.uid == uid
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.email == resource.data.email
        && (
          request.resource.data.condominioId == resource.data.get('condominioId', '') ||
          (
            resource.data.tipo == 'morador'
            && resource.data.get('condominioId', '') == ''
            && request.resource.data.condominioId is string
            && request.resource.data.condominioId.size() == 7
            && exists(/databases/$(database)/documents/condominios/$(request.resource.data.condominioId))
            && solicitacaoAprovadaPara(request.resource.data.condominioId, request.resource.data.get('vinculoSolicitacaoId', ''))
          )
        );
      allow delete: if false;
    }

    match /fotosPerfil/{uid} {
      allow read, create, update, delete: if logado() && request.auth.uid == uid;
    }

    match /pushDispositivos/{id} {
      allow create, update: if logado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo == perfil().tipo
        && request.resource.data.condominioId == perfil().get('condominioId', '')
        && request.resource.data.token is string
        && request.resource.data.token.size() > 10
        && request.resource.data.token.size() <= 300
        && request.resource.data.plataforma in ['android', 'ios']
        && request.resource.data.ativo == true;
      allow read: if logado() && resource.data.uid == request.auth.uid;
      allow delete: if logado() && resource.data.uid == request.auth.uid;
    }

    match /solicitacoesCondominio/{id} {
      allow create: if morador()
        && request.resource.data.moradorId == request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.condominioId is string
        && request.resource.data.condominioId.size() == 7
        && exists(/databases/$(database)/documents/condominios/$(request.resource.data.condominioId));
      allow read: if logado() && (
        resource.data.moradorId == request.auth.uid || mesmoCondominio(resource.data.condominioId)
      );
      allow update: if logado() && (
        (porteiro()
          && mesmoCondominio(resource.data.condominioId)
          && resource.data.status == 'pendente'
          && request.resource.data.status in ['aprovada', 'rejeitada']
          && request.resource.data.moradorId == resource.data.moradorId
          && request.resource.data.condominioId == resource.data.condominioId) ||
        (morador()
          && resource.data.moradorId == request.auth.uid
          && request.resource.data.moradorId == resource.data.moradorId
          && request.resource.data.condominioId == resource.data.condominioId
          && ((resource.data.status in ['pendente', 'rejeitada'] && request.resource.data.status == 'pendente') ||
              (resource.data.status == 'aprovada' && request.resource.data.status == 'concluida')))
      );
      allow delete: if false;
    }

    match /encomendas/{id} {
      allow create: if porteiro()
        && mesmoCondominio(request.resource.data.condominioId)
        && request.resource.data.porteiroId == request.auth.uid;
      allow update: if porteiro()
        && mesmoCondominio(resource.data.condominioId)
        && request.resource.data.condominioId == resource.data.condominioId;
      allow delete: if porteiro() && mesmoCondominio(resource.data.condominioId);
      allow read: if logado() && (
        (porteiro() && mesmoCondominio(resource.data.condominioId)) ||
        (morador() && resource.data.moradorId == request.auth.uid)
      );
    }

    match /encomendas/{encomendaId}/interacoes/{interacaoId} {
      allow create: if morador()
        && exists(/databases/$(database)/documents/encomendas/$(encomendaId))
        && get(/databases/$(database)/documents/encomendas/$(encomendaId)).data.moradorId == request.auth.uid
        && request.resource.data.encomendaId == encomendaId
        && request.resource.data.moradorId == request.auth.uid
        && request.resource.data.condominioId == get(/databases/$(database)/documents/encomendas/$(encomendaId)).data.condominioId
        && mesmoCondominio(request.resource.data.condominioId)
        && (
          (interacaoId == 'retirada'
            && request.resource.data.tipo == 'retirada_solicitada'
            && request.resource.data.status == 'pendente'
            && get(/databases/$(database)/documents/encomendas/$(encomendaId)).data.status == 'pendente') ||
          (interacaoId == 'contestacao'
            && request.resource.data.tipo == 'contestacao_encomenda'
            && request.resource.data.status == 'aberta'
            && request.resource.data.contestacaoTipo in ['nao_reconheco', 'nao_retirei'])
        );

      allow read: if logado()
        && exists(/databases/$(database)/documents/encomendas/$(encomendaId))
        && (
          (morador() && get(/databases/$(database)/documents/encomendas/$(encomendaId)).data.moradorId == request.auth.uid) ||
          (porteiro() && mesmoCondominio(get(/databases/$(database)/documents/encomendas/$(encomendaId)).data.condominioId))
        );

      allow update: if porteiro()
        && interacaoId == 'retirada'
        && mesmoCondominio(resource.data.condominioId)
        && resource.data.tipo == 'retirada_solicitada'
        && resource.data.status == 'pendente'
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.encomendaId == resource.data.encomendaId
        && request.resource.data.moradorId == resource.data.moradorId
        && request.resource.data.condominioId == resource.data.condominioId
        && request.resource.data.status == 'confirmada'
        && request.resource.data.confirmadaPorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','confirmadaEm','confirmadaPorId','confirmadaPorNome']);

      allow delete: if false;
    }

    match /fotosEncomendas/{id} {
      allow create: if porteiro() && mesmoCondominio(request.resource.data.condominioId);
      allow read: if logado() && (
        (porteiro() && mesmoCondominio(resource.data.condominioId)) ||
        (morador() && resource.data.moradorId == request.auth.uid)
      );
      allow update, delete: if false;
    }

    match /previsoes/{id} {
      allow create: if morador()
        && request.resource.data.moradorId == request.auth.uid
        && request.resource.data.condominioId is string
        && request.resource.data.condominioId.size() > 0
        && mesmoCondominio(request.resource.data.condominioId);
      allow read: if logado() && (
        resource.data.moradorId == request.auth.uid ||
        (porteiro() && mesmoCondominio(resource.data.condominioId))
      );
      allow update: if morador()
        && resource.data.moradorId == request.auth.uid
        && request.resource.data.moradorId == resource.data.moradorId
        && request.resource.data.condominioId == resource.data.condominioId;
      allow delete: if morador() && resource.data.moradorId == request.auth.uid;
    }

    match /notificacoes/{id} {
      allow create: if logado()
        && request.resource.data.condominioId is string
        && request.resource.data.condominioId.size() > 0
        && request.resource.data.mensagem is string
        && request.resource.data.mensagem.size() > 0
        && request.resource.data.mensagem.size() <= 1000
        && (
          (
            porteiro()
            && mesmoCondominio(request.resource.data.condominioId)
            && request.resource.data.get('destinatarioTipo', 'morador') == 'morador'
            && request.resource.data.moradorId is string
            && moradorExiste(request.resource.data.moradorId)
            && (((request.resource.data.tipo in ['chegada', 'retirada', 'lembrete'])
                && moradorNoCondominio(request.resource.data.moradorId, request.resource.data.condominioId)) ||
              notificacaoVinculoValidaParaMorador())
          ) ||
          (
            request.resource.data.destinatarioTipo == 'porteiro'
            && request.resource.data.remetenteId == request.auth.uid
            && request.resource.data.lidaPor is list
            && request.resource.data.lidaPor.size() == 0
            && (avisoSolicitacaoValidoParaPortaria() ||
                avisoPrevisaoValidoParaPortaria() ||
                avisoDenunciaValidoParaPortaria() ||
                avisoInteracaoEncomendaValidoParaPortaria())
          ) ||
          avisoRespostaMuralValido()
        );

      allow read: if logado() && (
        resource.data.moradorId == request.auth.uid ||
        (porteiro()
          && resource.data.get('destinatarioTipo', '') == 'porteiro'
          && mesmoCondominio(resource.data.condominioId))
      );

      allow update: if logado() && (
        (resource.data.moradorId == request.auth.uid
          && request.resource.data.moradorId == resource.data.moradorId
          && request.resource.data.condominioId == resource.data.condominioId
          && request.resource.data.lida is bool
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida'])) ||
        (porteiro()
          && resource.data.get('destinatarioTipo', '') == 'porteiro'
          && mesmoCondominio(resource.data.condominioId)
          && request.resource.data.lidaPor is list
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lidaPor']))
      );
      allow delete: if false;
    }

    match /ocrLeituras/{id} {
      allow create: if porteiro()
        && request.resource.data.porteiroId == request.auth.uid
        && mesmoCondominio(request.resource.data.condominioId);
      allow read: if porteiro() && mesmoCondominio(resource.data.condominioId);
      allow update: if porteiro()
        && mesmoCondominio(resource.data.condominioId)
        && request.resource.data.condominioId == resource.data.condominioId
        && request.resource.data.porteiroId == resource.data.porteiroId;
      allow delete: if false;
    }

    match /ocrTestes/{id} {
      allow create: if porteiro()
        && request.resource.data.porteiroId == request.auth.uid
        && mesmoCondominio(request.resource.data.condominioId);
      allow read: if porteiro() && mesmoCondominio(resource.data.condominioId);
      allow update, delete: if false;
    }

    match /auditoria/{id} {
      allow create: if porteiro()
        && request.resource.data.atorId == request.auth.uid
        && mesmoCondominio(request.resource.data.condominioId);
      allow read: if logado() && (
        (porteiro() && mesmoCondominio(resource.data.condominioId)) ||
        (morador() && resource.data.moradorId == request.auth.uid)
      );
      allow update, delete: if false;
    }

    match /mural/{id} {
      allow read: if logado() && mesmoCondominio(resource.data.condominioId);
      allow create: if logado()
        && mesmoCondominio(request.resource.data.condominioId)
        && request.resource.data.autorId == request.auth.uid
        && request.resource.data.autorNome is string
        && request.resource.data.autorNome.size() > 0
        && request.resource.data.autorNome.size() <= 120
        && request.resource.data.autorTipo == perfil().tipo
        && !banidoNoMural(request.resource.data.condominioId, request.auth.uid)
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 1000
        && (
          !request.resource.data.keys().hasAny(['respostaParaId']) ||
          (
            request.resource.data.respostaParaId is string
            && request.resource.data.respostaParaId.size() > 0
            && request.resource.data.respostaParaAutorId is string
            && request.resource.data.respostaParaAutorId.size() > 0
            && request.resource.data.respostaParaAutorId != request.auth.uid
          )
        );
      allow update: if false;
      allow delete: if logado()
        && mesmoCondominio(resource.data.condominioId)
        && (resource.data.autorId == request.auth.uid || porteiro());
    }

    match /muralDenuncias/{id} {
      allow create: if logado()
        && mesmoCondominio(request.resource.data.condominioId)
        && request.resource.data.denuncianteId == request.auth.uid
        && request.resource.data.autorId != request.auth.uid
        && request.resource.data.comentarioId is string
        && request.resource.data.comentarioId.size() > 0;
      allow read: if logado() && (
        resource.data.denuncianteId == request.auth.uid ||
        (porteiro() && mesmoCondominio(resource.data.condominioId))
      );
      allow update: if porteiro()
        && mesmoCondominio(resource.data.condominioId)
        && request.resource.data.condominioId == resource.data.condominioId
        && request.resource.data.denuncianteId == resource.data.denuncianteId
        && request.resource.data.autorId == resource.data.autorId
        && request.resource.data.comentarioId == resource.data.comentarioId;
      allow delete: if false;
    }

    match /muralBanidos/{id} {
      allow get: if logado() && (
        id == perfil().get('condominioId', '') + '_' + request.auth.uid ||
        (resource != null && porteiro() && mesmoCondominio(resource.data.condominioId))
      );
      allow list: if porteiro() && mesmoCondominio(resource.data.condominioId);
      allow create, update: if porteiro() && mesmoCondominio(request.resource.data.condominioId);
      allow delete: if false;
    }

    match /muralBanimentosPublicos/{id} {
      allow read: if logado() && mesmoCondominio(resource.data.condominioId);
      allow create, update: if porteiro()
        && mesmoCondominio(request.resource.data.condominioId)
        && request.resource.data.usuarioId is string
        && request.resource.data.usuarioId.size() > 0
        && request.resource.data.usuarioNome is string
        && request.resource.data.usuarioNome.size() > 0
        && request.resource.data.ativo is bool
        && id == request.resource.data.condominioId + '_' + request.resource.data.usuarioId;
      allow delete: if false;
    }

    match /logsOCR/{id} {
      allow read: if porteiro() && mesmoCondominio(resource.data.condominioId);
      allow write: if false;
    }
  }
}
